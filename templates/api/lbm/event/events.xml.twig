<?xml version="1.0" encoding="UTF-8" ?>
<rss version="2.0">
    <channel>
        <title>Événements du Bus Magique</title>
        <link>{{ absolute_url(path('app_api_lbm_events_xml')) }}</link>
        <description>Flux des événements du Bus Magique.</description>
        <language>fr-fr</language>
        {% for event in events %}
            <item>
                <title><![CDATA[ {{ event.data.title|striptags|raw }} ]]></title>
                <link>{{ event.data.deepLink|replace({'discord://': 'https://'}) }}</link>
                <description><![CDATA[ {{ include('api/lbm/event/_event-description.html.twig', {event: event})|trim }} ]]></description>
                {% if event.image %}
                    <enclosure url="{{ absolute_url(vich_uploader_asset(event)) }}" length="{{ event.imageSize ?? 86685 }}" type="{{ item.imageType ?? 'image/jpeg' }}" />
                {% endif %}
                <pubDate>{{ event.startAt|date('r') }}</pubDate>
                <guid isPermaLink="false">{{ event.uid }}</guid>
            </item>
        {% endfor %}
    </channel>
</rss>